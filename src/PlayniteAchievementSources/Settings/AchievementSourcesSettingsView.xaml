<UserControl x:Class="PlayniteAchievementSources.Settings.AchievementSourcesSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="500"
             Loaded="OnLoaded"
             DataContextChanged="OnDataContextChanged">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Achievement Sources" />
            <TextBlock Margin="0,4,0,18"
                       TextWrapping="Wrap"
                       Text="Control how local and online-compatible achievement sources are discovered. These settings do not modify game files or platform databases." />

            <TextBlock FontSize="14" FontWeight="SemiBold" Text="Default tracking mode" />
            <TextBlock Margin="0,3,0,6"
                       TextWrapping="Wrap"
                       Text="Games can override this default from Achievement Sources in their right-click menu." />
            <ComboBox Width="220"
                      HorizontalAlignment="Left"
                      ItemsSource="{Binding TrackingModes}"
                      SelectedItem="{Binding Settings.DefaultTrackingMode, Mode=TwoWay}" />

            <CheckBox Margin="0,16,0,0"
                      IsChecked="{Binding Settings.EnableLocalSources, Mode=TwoWay}"
                      Content="Enable local achievement sources" />
            <TextBlock Margin="20,3,0,0"
                       TextWrapping="Wrap"
                       Text="Allows read-only discovery of supported local schemas and unlock-state files." />

            <CheckBox Margin="0,12,0,0"
                      IsChecked="{Binding Settings.EnableOnlineMetadata, Mode=TwoWay}"
                      Content="Allow online metadata lookups" />
            <TextBlock Margin="20,3,0,0"
                       TextWrapping="Wrap"
                       Text="Allows metadata requests when names, descriptions, icons, or hidden status are unavailable locally." />

            <Separator Margin="0,20,0,18" />

            <TextBlock FontSize="14" FontWeight="SemiBold" Text="Steam metadata" />
            <TextBlock Margin="0,3,0,8"
                       TextWrapping="Wrap"
                       Text="The key is optional. It is stored with Windows user-level encryption and is never written to diagnostics." />

            <TextBlock Text="Steam Web API key" />
            <PasswordBox x:Name="SteamApiKeyBox"
                         Width="360"
                         Margin="0,4,0,0"
                         HorizontalAlignment="Left"
                         MaxLength="32"
                         PasswordChanged="OnSteamApiKeyChanged" />
            <TextBlock Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Text="{Binding Settings.SteamApiKeyStatus}" />

            <CheckBox Margin="0,12,0,0"
                      IsChecked="{Binding Settings.UseSteamApiWhenLocalMetadataMissing, Mode=TwoWay}"
                      Content="Use the Steam API when local metadata is missing" />

            <Button Width="100"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Left"
                    Content="Clear key"
                    Click="OnClearSteamApiKey" />

            <Separator Margin="0,20,0,18" />

            <TextBlock FontSize="14" FontWeight="SemiBold" Text="Current milestone" />
            <TextBlock Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Text="Per-game tracking modes, versioned local snapshots, and a producer-neutral bridge catalog are available. Direct Playnite Achievements import, notifications, and live monitoring are not enabled yet." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
